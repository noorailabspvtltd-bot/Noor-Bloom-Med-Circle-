  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/clinic-test.cjs",
    "build:web": "expo export --platform web",
    "format": "prettier --write App.tsx src scripts README.md",
    "lint": "expo lint",
    "typecheck:backend": "tsc -p backend/tsconfig.json",
    "build:backend": "wrangler deploy --config backend/wrangler.jsonc --dry-run --outdir backend-build",
